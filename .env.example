# Generate a 32-byte key: openssl rand -base64 32
DATABASE_URL="file:./dev.db"
APP_ENCRYPTION_KEY="replace-with-base64-encoded-32-byte-key"
APP_MODE="mock"
DEFAULT_COUNTRY="United States"
DEFAULT_LANGUAGE="English"
SEARCH_RESULT_LIMIT="10"
SEARCH_TIMEOUT_MS="12000"
CRAWL_CONCURRENCY="2"
CACHE_TTL_SECONDS="3600"
SEARCH_BUDGET_USD="5"
# Optional provider keys. All calls happen server-side only.
TAVILY_API_KEY=""
BRAVE_API_KEY=""
SERPER_API_KEY=""
EXA_API_KEY=""
BOCHA_API_KEY=""
PERPLEXITY_API_KEY=""