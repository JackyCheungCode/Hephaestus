# For local Worker runtime, put secrets in .dev.vars (never commit it).
# Generate APP_ENCRYPTION_KEY with: openssl rand -base64 32
APP_ENCRYPTION_KEY=""
APP_PASSWORD="" # Required before enabling a public deployment
APP_MODE="mock"
DEFAULT_COUNTRY="United States"
DEFAULT_LANGUAGE="English"
SEARCH_RESULT_LIMIT="10"
SEARCH_TIMEOUT_MS="12000"
CACHE_TTL_SECONDS="3600"
SEARCH_BUDGET_USD="5"
# Provider keys are entered in the app Settings page and encrypted in D1.
TAVILY_API_KEY=""
BRAVE_API_KEY=""
SERPER_API_KEY=""
EXA_API_KEY=""
BOCHA_API_KEY=""
PERPLEXITY_API_KEY=""
