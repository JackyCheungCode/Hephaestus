{
  "name": "hephaestus-lead-finder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start -H 0.0.0.0",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "dev:worker": "wrangler dev cloudflare/worker.js --ip 0.0.0.0 --port 8787",
    "deploy:worker": "wrangler deploy cloudflare/worker.js",
    "d1:local": "wrangler d1 execute hephaestus-leads --local --file=cloudflare/schema.sql",
    "d1:remote": "wrangler d1 execute hephaestus-leads --remote --file=cloudflare/schema.sql"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cheerio": "^1.0.0",
    "lucide-react": "^0.468.0",
    "next": "^14.2.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "wrangler": "^4.44.0"
  }
}